{
  "version": 42,
  "system": "class-system",
  "prologueRule": {"villagerIsTutorialOnly":true,"villagerParticipatesInMastery":false,"villagerAvailableInNormalRuns":false,"description":"村民僅存在於遊戲首次序章／教學；序章完成後不再作為正式遠征職業，也不參與一般 Mastery。"},
  "runStartRule": {"defaultTier1Classes":["tier1_warrior","tier1_scout","tier1_mage","tier1_priest"],"oneDefaultClassPerProtagonist":true,"playerMayReplaceWithAnyUnlockedClass":true,"duplicateClassesAllowed":true,"relicLoadoutPerProtagonist":1,"description":"每次正式 Run 開始前進入遠征準備；預設戰士、斥候、法師、牧師各一名，但可改成任何已解鎖職業。一般職業可重複；特殊職業另受隊伍唯一性規則限制。"},
  "classFeatureRule": {"traitIsDescriptionOnly":true,"traitHasCombatEffect":false,"activeSkillsPerClass":1,"passiveSkillsPerClass":1,"description":"職業特性只用來說明定位與玩法傾向，不是技能；每個正式職業自身只提供 1 個有限 Charge 的主動技能與 1 個被動技能。"},
  "basicAttackRule": {"definedPerClass":true,"automaticallyInherited":false,"boardSize":"9x9","rangeScale":{"melee":1,"standardRanged":2,"longRanged":3,"special":4},"description":"一般攻擊型態由目前職業本身定義，不視為被動技能，也不隨高 Tier 技能繼承自動帶入。9x9 戰場初步以 1 格近戰、2 格標準遠距、3 格長距離、4 格以上特殊／狙擊級作為尺度。"},
  "activeSkillChargeBaselineRule": {"tier1":9,"tier2":6,"tier3":"to-be-defined","special":"to-be-defined","individualOverrideAllowed":false,"description":"主動技能 Charge 改為依 Tier 統一：Tier 1 一律 9，Tier 2 一律 6；Tier 3 與最終特殊職業另行定義。"},
  "skillTargetingRule": {"movementDirections":4,"skillDirectionsDefinedPerSkill":true,"eightDirectionSkillsAllowed":true,"description":"角色移動固定四方向；技能是否可使用斜向格由個別技能自行定義。支援 8 方向的技能可沿上、下、左、右與四個斜向進行直線瞄準或延伸。"},
  "statusDurationRule": {"defaultTimedStatusDuration":"until-source-next-action-start","sourceCharacterBased":true,"explicitSkillOverrideAllowed":true,"battleEndClearsTemporaryStatuses":true,"description":"一般時間型增益／減益若未另行指定解除條件，自施加時開始，持續至效果來源角色下一次自身行動開始時解除。技能可明確覆寫，例如目標下一次行動、下一次受傷、下一次攻擊、直到移動或直到目標死亡。"},
  "pageResponsibilityRule": {"classSystemPage":["class-relationship","class-role","class-feature","transition-path","skill-inheritance-rule","special-class-unlock"],"masterySystemPage":["class-sector","class-role","class-feature","basic-attack","active-skill-and-charges","passive-skill","mastery-checklist","mastery-progress-display","class-combat-archive-link"],"classDescriptionFieldRemoved":true,"description":"職業系統頁專注職業關係、定位、特性、技能繼承與特殊職業解鎖；熟練度系統頁負責完整職業資訊、Mastery 與其長期紀錄來源規則。舊有 summary／職業描述欄位已完全移除。"},
  "skillInheritanceRule": {"enabled":true,"tier2InheritsLinkedTier1Skills":true,"tier3InheritsInspirationTier2Skills":true,"recursiveInheritance":true,"deduplicateBySourceClass":true,"basicAttackInherited":false,"skillSlotLimit":null,"legacyTraitReplacement":true,"specialClassInheritance":"to-be-defined","description":"Tier 2 完整繼承正式連線 Tier 1 的主被動技能；Tier 3 完整繼承 Inspiration Links 對應 Tier 2 與其祖先技能；同一來源技能只計一次。一般攻擊型態不屬於技能繼承。特殊職業的最終技能繼承方式另行定義。"},
  "angleRule": {"promotionRange":45,"sameTierMovement":"adjacent"},
  "masteryRule": {"scope":"party","sharedByProtagonists":4,"persistsAcrossExpeditions":true,"sameClassContributionsMerged":true,"trainingTarget":"player-understanding-of-class","recordDuringBattle":true,"checklistCompletionImmediate":true,"masteryCountUpdatesImmediately":true,"masteredEvaluatedAfterBattle":true,"characterDeathDoesNotRollbackProgress":true,"progressDisplay":{"checklistFormat":"current / target","completedChecklistPrefix":"✓","classProgressFormat":"Mastery completed / total","allCompleteBeforeSettlement":"Mastery total / total · 待戰後結算","afterSettlement":"MASTERED","showPercentage":false,"visibleChecklistValueCapsAtTarget":true,"underlyingArchiveContinuesBeyondTarget":true},"masteredGrantsCombatStats":false,"masteredEffects":["allow-transition-out","count-for-tier3-inspiration","persist-across-runs"],"tier1And2":{"completionModel":"class-specific-checklist","checklistItemsPerClass":6,"commonChecklistItems":3,"classSpecificChecklistItems":3,"classSpecificBasis":["class-playstyle","passive-skill","active-skill"],"targetRunsToMaster":2},"tier3":{"usesCommonChecklist":false,"fixedChecklistCount":null,"completionModel":"fully-class-specific","designGoal":"每個 Tier 3 使用完全依該職業特色設計的 Mastery，不再套用 Tier 1／2 的 3 共通 + 3 專屬模板。"},"description":"Mastery 是四名主角共用、以職業為單位的永久進度；達標與 Mastery X/Y 即時更新，MASTERED 在戰後正式判定。"},
  "classCombatArchiveRule": {"name":"職業戰績檔案","englishName":"Class Combat Archive","scope":"per-class-global","persistsAcrossRuns":true,"sharedByProtagonists":true,"playerViewable":true,"hiddenUnrevealedClassesNotShown":true,"hiddenContentMustNotLeakThroughMetricNames":true,"continuesCountingAfterMastery":true,"valuesMayExceedMasteryTargets":true,"masteryUsesArchiveThresholds":true,"notLimitedToCombat":true,"recordCategories":["combat","exploration","map-event","event-choice","named-enemy","mini-boss","boss","class-behavior","other-class-attributable-history"],"examples":["battles-completed","kills","elite-boss-participation","damage-taken-events","passive-trigger-events","active-skill-kills","healing-events","map-event-entry-count","special-node-entry-count","event-choice-count","named-enemy-encounters","named-enemy-kills","mini-boss-kills","boss-kills"],"description":"職業戰績檔案是以職業為單位的跨 Run 長期完整歷程紀錄。"},
  "expeditionRecordIntegrationRule": {"name":"本次遠征紀錄","englishName":"Expedition Record","scope":"current-run","resetsEachRun":true,"notLimitedToCombat":true,"sameGameplayEventMayUpdateArchiveAndRunRecord":true,"recordCategories":["combat","exploration","map-event","event-choice","named-enemy","mini-boss","boss","relic","class-change","character-death","mastery-progress","other-run-history"],"usedForExpeditionReport":true,"usedForTitleGeneration":true,"titleGenerationPrefersRunDataOverLifetimeTotals":true,"description":"本次遠征紀錄保存當前 Run 的完整歷程，Run 結束後整理成遠征報告。"},
  "classDesignFramework": {"strategy":"framework-first","defineAllClassesBeforePrototype":false,"statusValues":["draft","confirmed"],"requiredDesignFields":["basicAttack","passiveSkill","activeSkill","masteryChecklist"],"baseClassFieldsForMasteryPage":["sector","role","trait"],"prototypeRule":"所有已存在於職業樹的職業都顯示於 Mastery UI；draft 職業顯示已完成的技能與 Mastery 內容，尚未定案欄位必須明確標示。Tier 1／2 使用固定 6 項框架；Tier 3 顯示完全職業專屬 Mastery 待設計。","description":"目前 confirmed 為 Tier 1 戰士、斥候、法師、牧師，以及 Tier 2 騎士、狂戰士、武士、遊俠、刺客、舞刃者、魔劍士、巫師、咒術師、神官、吟遊詩人、煉金術士。"},
  "classTransitionRule": {"duringRunTiming":"one-fixed-midpoint-per-region","transitionPointsPerRegion":1,"transitionPointPlacement":"approximately-mid-route","randomEventRequired":false,"afterBattle":"evaluate-mastered-unlocks-and-recovery-only","currentClassMustBeMastered":true,"perCharacterTransitionCountLimit":null,"refillAllAvailableActiveSkillChargesAfterTransition":true,"description":"每個 Region 固定 1 個轉職點；完成轉職後，新 Build 所有可用主動技能 Charge 補滿。"},
  "tier3RevealRule": {"hiddenBeforeFirstUnlock":true,"hideTier3RingBeforeReveal":true,"hideTier3LabelBeforeReveal":true,"hideTier3PlaceholdersBeforeReveal":true,"hideInspirationLinksBeforeReveal":true,"firstRevealTrigger":"first-tier3-unlock","revealPresentation":"expand-or-zoom-class-tree-outward","prototypeMayShowTier3Early":true,"description":"正式遊戲在第一次 Tier 3 解鎖前完全隱藏 Tier 3；Prototype 可提前顯示。"},
  "endgameTierExpectation": {"tier3RequiredBySystem":false,"tier3ExpectedForNormalFullClear":true,"tier2OnlyClearAllowed":true,"tier2OnlyClearIsChallengeAchievement":true,"description":"Tier 3 不是系統硬門檻，但屬正常後期戰力預期。"},
  "inspirationRule": {"masteryScope":"party","requireAllLinkedTier2Masteries":true,"unlockCondition":"完成目標 Tier 3 所有 Inspiration Links 對應 Tier 2 職業的 Mastery 後解鎖。","transitionRequirement":"Tier 3 解鎖後仍需於 Region 固定轉職點正式轉職，且目前職業必須已 Mastered。","relationshipRequired":false,"specialEventRequired":false,"linksAreTransitionPaths":false,"example":{"targets":["影刃術士","幻刃魔導士"],"tier2Links":["魔劍士","舞刃者","刺客"]}},
  "legacyTraitRule": {"enabled":false,"status":"archived","description":"舊版 Legacy Trait 已取消，由完整技能繼承取代。"},
  "specialClassRule": {"outsideConcentricClassTree":true,"displayedAsExternalNodes":true,"finalClassCount":4,"onePerSector":true,"sectors":["warrior","agile","magic","support"],"isTier4":false,"isFinalClass":true,"unlockRequiresAllSectorTier3Masteries":true,"unlockRequiresCorrespondingSpecialRelic":true,"unlockLogic":"AND","duplicateSameSpecialClassInPartyAllowed":false,"differentSpecialClassesMayCoexist":true,"normalMasteryTemplateApplies":false,"skillInheritance":"to-be-defined","description":"四個最終特殊職業各代表一個主要職業系，位於 Tier 0～3 同心圓之外。"},
  "classDesigns": {
    "tier1_warrior":{"status":"confirmed","basicAttack":{"name":"近戰攻擊","range":1,"damageType":"physical","attackStyle":"melee","charges":null,"effect":"對相鄰敵人進行不消耗 Charge 的物理普通攻擊。"},"passiveSkill":{"name":"堅守","effect":"受到敵方攻擊後，直到下一次自身行動開始前，後續受到的傷害降低 29%。","damageReductionPercent":29,"firstHitReduced":false,"stackable":false},"activeSkill":{"name":"猛擊","maxCharges":9,"chargeCost":1,"skillType":"general-attack","range":1,"damageType":"physical","effect":"對相鄰敵人造成約普通攻擊 1.5 倍的近戰傷害。","damageMultiplierPrototype":1.5},"masteryChecklist":[{"id":"warrior_common_battles","archiveMetric":"battles-completed","category":"common","description":"使用戰士完成戰鬥","target":24,"unit":"場"},{"id":"warrior_common_kills","archiveMetric":"kills","category":"common","description":"使用戰士擊倒敵人","target":45,"unit":"名"},{"id":"warrior_common_elite_boss","archiveMetric":"elite-boss-participation","category":"common","description":"使用戰士參與擊敗 Elite / Boss","target":8,"unit":"次"},{"id":"warrior_playstyle_take_hits","archiveMetric":"damage-taken-events","category":"class-playstyle","description":"使用戰士承受敵方攻擊","target":60,"unit":"次"},{"id":"warrior_passive_hold_fast_hits","archiveMetric":"hold-fast-damage-taken-events","category":"passive-skill","description":"在「堅守」生效期間受到敵方攻擊","target":30,"unit":"次"},{"id":"warrior_active_slam_kills","archiveMetric":"slam-kills","category":"active-skill","description":"使用「猛擊」擊倒敵人","target":20,"unit":"次"}]},
    "tier1_scout":{"status":"confirmed","basicAttack":{"name":"近戰攻擊","range":1,"damageType":"physical","attackStyle":"melee","charges":null,"effect":"對相鄰敵人進行不消耗 Charge 的物理普通攻擊。"},"passiveSkill":{"name":"游擊","effect":"本回合若先移動，再進行普通攻擊或主動技能，行動結束後獲得暫時閃避提升，持續至下一次自身行動開始。","evasionBonusPrototype":"15%-20%","stackable":false},"activeSkill":{"name":"疾行","maxCharges":9,"chargeCost":1,"skillType":"general-support","effect":"本回合移動距離 +3 格；使用後仍可依一般行動規則執行合法行動。"},"masteryChecklist":[{"id":"scout_common_battles","archiveMetric":"battles-completed","category":"common","description":"使用斥候完成戰鬥","target":24,"unit":"場"},{"id":"scout_common_kills","archiveMetric":"kills","category":"common","description":"使用斥候擊倒敵人","target":45,"unit":"名"},{"id":"scout_common_elite_boss","archiveMetric":"elite-boss-participation","category":"common","description":"使用斥候參與擊敗 Elite / Boss","target":8,"unit":"次"},{"id":"scout_playstyle_move_then_action","archiveMetric":"move-then-action-events","category":"class-playstyle","description":"先移動，再於同一回合完成普通攻擊或主動技能","target":50,"unit":"次"},{"id":"scout_passive_guerrilla_evade","archiveMetric":"guerrilla-evasion-events","category":"passive-skill","description":"觸發「游擊」後成功迴避敵方攻擊","target":15,"unit":"次"},{"id":"scout_active_dash_action","archiveMetric":"dash-then-normal-attack-events","category":"active-skill","description":"使用「疾行」後，在同一回合完成普通攻擊","target":20,"unit":"次"}]},
    "tier1_mage":{"status":"confirmed","basicAttack":{"name":"魔法射擊","range":2,"damageType":"magic","attackStyle":"ranged","charges":null,"effect":"對 2 格內單一敵人進行不消耗 Charge 的遠距魔法普通攻擊。"},"passiveSkill":{"name":"凝神","effect":"本回合施放造成傷害的主動技能前若未移動，該次主動技能造成的傷害提高 30%。","damageBonusPercent":30,"requiresNoMovementBeforeCast":true},"activeSkill":{"name":"魔力彈","maxCharges":9,"chargeCost":1,"skillType":"general-attack","range":3,"damageType":"magic","effect":"對 3 格內單一敵人造成約普通攻擊 1.5 倍的魔法傷害。","damageMultiplierPrototype":1.5},"masteryChecklist":[{"id":"mage_common_battles","archiveMetric":"battles-completed","category":"common","description":"使用法師完成戰鬥","target":24,"unit":"場"},{"id":"mage_common_kills","archiveMetric":"kills","category":"common","description":"使用法師擊倒敵人","target":45,"unit":"名"},{"id":"mage_common_elite_boss","archiveMetric":"elite-boss-participation","category":"common","description":"使用法師參與擊敗 Elite / Boss","target":8,"unit":"次"},{"id":"mage_playstyle_ranged_damage","archiveMetric":"damage-from-two-plus-tiles","category":"class-playstyle","description":"在距離敵人 2 格以上的位置造成傷害","target":50,"unit":"次"},{"id":"mage_passive_focus_hits","archiveMetric":"focus-boosted-active-hits","category":"passive-skill","description":"觸發「凝神」後，以獲得加成的主動技能命中敵人","target":30,"unit":"次"},{"id":"mage_active_magic_bolt_kills","archiveMetric":"magic-bolt-kills","category":"active-skill","description":"使用「魔力彈」擊倒敵人","target":20,"unit":"次"}]},
    "tier1_priest":{"status":"confirmed","basicAttack":{"name":"近戰攻擊","range":1,"damageType":"physical","attackStyle":"melee","charges":null,"effect":"對相鄰敵人進行不消耗 Charge 的低傷害物理普通攻擊。"},"passiveSkill":{"name":"恩典","effect":"治療生命值低於 50% 的友方角色時，該次治療量提高 30%。","healingBonusPercent":30,"targetHpBelowPercent":50},"activeSkill":{"name":"治癒","maxCharges":9,"chargeCost":1,"skillType":"general-support","range":2,"effect":"恢復 2 格內單一友方角色的 HP。"},"masteryChecklist":[{"id":"priest_common_battles","archiveMetric":"battles-completed","category":"common","description":"使用牧師完成戰鬥","target":24,"unit":"場"},{"id":"priest_common_kills","archiveMetric":"kills","category":"common","description":"使用牧師擊倒敵人","target":45,"unit":"名"},{"id":"priest_common_elite_boss","archiveMetric":"elite-boss-participation","category":"common","description":"使用牧師參與擊敗 Elite / Boss","target":8,"unit":"次"},{"id":"priest_playstyle_heal_allies","archiveMetric":"healing-events","category":"class-playstyle","description":"使用牧師對友方角色進行治療","target":50,"unit":"次"},{"id":"priest_passive_grace_heals","archiveMetric":"grace-healing-events","category":"passive-skill","description":"對 HP 低於 50% 的友方觸發「恩典」並完成治療","target":25,"unit":"次"},{"id":"priest_active_heal_rescue","archiveMetric":"heal-cross-fifty-percent-events","category":"active-skill","description":"使用「治癒」將友方角色從低於 50% HP 恢復至 50% 以上","target":20,"unit":"次"}]},
    "tier2_knight":{"status":"confirmed","basicAttack":{"name":"近戰攻擊","range":1,"damageType":"physical","attackStyle":"melee","charges":null,"effect":"對相鄰敵人進行不消耗 Charge 的物理普通攻擊。"},"passiveSkill":{"name":"護衛","adjacentDefinition":"周圍 8 格","damageReductionPercent":25,"stackable":false,"effect":"騎士周圍 8 格內的友方受到傷害時，該次傷害降低 25%。"},"activeSkill":{"name":"守護","maxCharges":6,"chargeCost":1,"skillType":"strong-support","adjacentDefinition":"周圍 8 格","duration":"until-knight-moves","endsOnAnyPositionChange":true,"redirectAllAdjacentAllyDamage":true,"transferredDamageUsesKnightDefense":true,"transferredDamageReductionPercent":25,"effect":"啟動後，周圍 8 格內友方所受到的所有傷害全部改由騎士承受；轉移後先套用護衛的 25% 減傷，再依騎士自身防禦／魔法防禦計算。效果持續到騎士位置發生改變為止。"},"masteryChecklist":[{"id":"knight_common_battles","archiveMetric":"battles-completed","category":"common","description":"使用騎士完成戰鬥","target":16,"unit":"場"},{"id":"knight_common_kills","archiveMetric":"kills","category":"common","description":"使用騎士擊倒敵人","target":30,"unit":"名"},{"id":"knight_common_elite_boss","archiveMetric":"elite-boss-participation","category":"common","description":"使用騎士參與擊敗 Elite / Boss","target":5,"unit":"次"},{"id":"knight_playstyle_guard_reduction","archiveMetric":"guard-adjacent-ally-damage-reduction-events","category":"class-playstyle","description":"「護衛」成功替相鄰友方降低傷害","target":30,"unit":"次"},{"id":"knight_active_protect_redirect","archiveMetric":"protect-damage-redirect-events","category":"active-skill","description":"在「守護」狀態下替友方承受傷害","target":25,"unit":"次"},{"id":"knight_active_protect_hold","archiveMetric":"protect-three-plus-hits-per-activation-events","category":"active-skill","description":"單次「守護」持續期間替友方承受至少 3 次傷害","target":8,"unit":"次"}]},
