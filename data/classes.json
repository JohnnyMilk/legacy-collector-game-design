  "classes":[{"id":"tier0_villager","name":"村民","tier":0,"sector":"center","angle":null,"role":"序章教學職業","trait":"四名主角尚未形成正式職業道路前的共同故事起點。","hidden":false},{"id":"tier1_warrior","name":"戰士","tier":1,"sector":"warrior","angle":-90,"role":"近戰前排／穩定輸出","trait":"擅長在前線持續作戰，依靠較高的生存能力與穩定近戰輸出維持戰線，是最直接、可靠的基礎近戰職業。","hidden":false},{"id":"tier1_scout","name":"斥候","tier":1,"sector":"agile","angle":0,"role":"高速機動／先手騷擾","trait":"擅長利用高機動與較早的行動順序取得位置優勢，在敵人完成部署前先行接觸、攻擊或調整站位。","hidden":false},{"id":"tier1_mage","name":"法師","tier":1,"sector":"magic","angle":90,"role":"遠距魔法輸出／定點爆發","trait":"擅長保持安全距離並預先選擇施法位置，以有限的主動技能 Charge 換取高於普通攻擊的遠距魔法傷害。","hidden":false},{"id":"tier1_priest","name":"牧師","tier":1,"sector":"support","angle":180,"role":"治療支援／隊伍維持","trait":"擅長以穩定治療維持隊伍續戰，優先修補受傷角色，降低隊伍在長線遠征中的損耗。","hidden":false},{"id":"tier2_knight","name":"騎士","tier":2,"sector":"warrior","angle":-120,"role":"防禦前排／隊友守護","trait":"以站位保護相鄰隊友，並在關鍵時刻主動承接周圍友方傷害；守住陣地時能將隊伍風險集中到自身。","hidden":false},{"id":"tier2_berserker","name":"狂戰士","tier":2,"sector":"warrior","angle":-90,"role":"高風險近戰輸出","trait":"主動以自身 HP 換取高倍率近戰攻擊，並在低生命狀態下提高整體傷害；核心玩法是在生存風險與爆發輸出之間做取捨。","hidden":false},{"id":"tier2_samurai","name":"武士","tier":2,"sector":"warrior","angle":-60,"role":"單體近戰／反擊破防","trait":"擅長承受並看穿敵方近戰攻勢，以「見切」鎖定原攻擊者，再用精準反擊與破防攻擊處理單一目標。","hidden":false},{"id":"tier2_ranger","name":"遊俠","tier":2,"sector":"agile","angle":-30,"role":"遠距機動／距離控制","trait":"擅長維持與敵人的有效射擊距離，利用遠距傷害與攻擊後再移動持續調整站位，在保持安全距離的同時穩定輸出。","hidden":false},{"id":"tier2_assassin","name":"刺客","tier":2,"sector":"agile","angle":0,"role":"單體爆發","trait":"偏重先手與高價值目標處理，追求快速完成擊殺。","hidden":false},{"id":"tier2_blade_dancer","name":"舞刃者","tier":2,"sector":"agile","angle":30,"role":"連續機動攻擊","trait":"偏重移動與攻擊順序的交錯操作，以連續機動建立優勢。","hidden":false},{"id":"tier2_spellblade","name":"魔劍士","tier":2,"sector":"magic","angle":60,"role":"近戰魔法混合輸出","trait":"偏重普通攻擊與魔法技能交替，形成近戰與法術混合節奏。","hidden":false},{"id":"tier2_wizard","name":"巫師","tier":2,"sector":"magic","angle":90,"role":"高強度魔法輸出","trait":"偏重純粹魔法火力與主動技能運用。","hidden":false},{"id":"tier2_occultist","name":"咒術師","tier":2,"sector":"magic","angle":120,"role":"弱化與控制","trait":"偏重負面狀態、干擾與戰場控制。","hidden":false},{"id":"tier2_cleric","name":"神官","tier":2,"sector":"support","angle":150,"role":"治療","trait":"偏重直接治療與長時間維持隊伍生存。","hidden":false},{"id":"tier2_bard","name":"吟遊詩人","tier":2,"sector":"support","angle":180,"role":"團隊增益","trait":"偏重群體增益與隊伍整體節奏。","hidden":false},{"id":"tier2_guardian","name":"守護者","tier":2,"sector":"support","angle":210,"role":"防禦支援","trait":"偏重防禦型支援與隊友保護。","hidden":false},{"id":"tier3_shadowblade_occultist","name":"影刃術士","tier":3,"sector":"agile","angle":22.5,"role":"高速魔法刺殺","trait":"融合高速機動、刺殺與魔法近戰，是敏捷與魔法交界的高階職業。","hidden":false},{"id":"tier3_phantom_blade_magister","name":"幻刃魔導士","tier":3,"sector":"magic","angle":45,"role":"連續魔法近戰","trait":"融合連續近戰、機動與魔法爆發，以多套前置技能組成高階攻勢。","hidden":false}]
