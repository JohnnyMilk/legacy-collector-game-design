{
  "version": 31,
  "system": "class-system",
  "prologueRule": {
    "villagerIsTutorialOnly": true,
    "villagerParticipatesInMastery": false,
    "villagerAvailableInNormalRuns": false,
    "description": "村民僅存在於遊戲首次序章／教學；序章完成後不再作為正式遠征職業，也不參與一般 Mastery。"
  },
  "runStartRule": {
    "defaultTier1Classes": ["tier1_warrior", "tier1_scout", "tier1_mage", "tier1_priest"],
    "oneDefaultClassPerProtagonist": true,
    "playerMayReplaceWithAnyUnlockedClass": true,
    "duplicateClassesAllowed": true,
    "relicLoadoutPerProtagonist": 1,
    "description": "每次正式 Run 開始前進入遠征準備；預設戰士、斥候、法師、牧師各一名，但可改成任何已解鎖職業。一般職業可重複；特殊職業另受隊伍唯一性規則限制。"
  },
  "classFeatureRule": {
    "traitIsDescriptionOnly": true,
    "traitHasCombatEffect": false,
    "activeSkillsPerClass": 1,
    "passiveSkillsPerClass": 1,
    "description": "職業特性只用來說明定位與玩法傾向，不是技能；每個正式職業自身只提供 1 個有限 Charge 的主動技能與 1 個被動技能。"
  },
  "basicAttackRule": {
    "definedPerClass": true,
    "automaticallyInherited": false,
    "boardSize": "9x9",
    "rangeScale": {"melee":1,"standardRanged":2,"longRanged":3,"special":4},
    "description": "一般攻擊型態由目前職業本身定義，不視為被動技能，也不隨高 Tier 技能繼承自動帶入。9x9 戰場初步以 1 格近戰、2 格標準遠距、3 格長距離、4 格以上特殊／狙擊級作為尺度。"
  },
  "activeSkillChargeBaselineRule": {
    "defaultFallback": 6,
    "strongSkill": 3,
    "generalAttackSkill": 9,
    "generalSupportSkill": 6,
    "individualOverrideAllowed": true,
    "description": "主動技能 Charge 先以類型設定基本保底：強勢技能 3、一般攻擊技能 9、一般輔助技能 6；若技能尚未分類則預設 6，之後再依個別技能強度與實測調整。"
  },
  "pageResponsibilityRule": {
    "classSystemPage": ["class-relationship", "class-role", "class-feature", "transition-path", "skill-inheritance-rule", "special-class-unlock"],
    "masterySystemPage": ["class-sector", "class-role", "class-feature", "basic-attack", "active-skill-and-charges", "passive-skill", "mastery-checklist", "mastery-progress-display", "class-combat-archive-link"],
    "classDescriptionFieldRemoved": true,
    "description": "職業系統頁專注職業關係、定位、特性、技能繼承與特殊職業解鎖；熟練度系統頁負責完整職業資訊、Mastery 與其長期紀錄來源規則。舊有 summary／職業描述欄位已完全移除。"
  },
  "skillInheritanceRule": {
    "enabled": true,
    "tier2InheritsLinkedTier1Skills": true,
    "tier3InheritsInspirationTier2Skills": true,
    "recursiveInheritance": true,
    "deduplicateBySourceClass": true,
    "basicAttackInherited": false,
    "skillSlotLimit": null,
    "legacyTraitReplacement": true,
    "specialClassInheritance": "to-be-defined",
    "description": "Tier 2 完整繼承正式連線 Tier 1 的主被動技能；Tier 3 完整繼承 Inspiration Links 對應 Tier 2 與其祖先技能；同一來源技能只計一次。一般攻擊型態不屬於技能繼承。特殊職業的最終技能繼承方式另行定義。"
  },
  "angleRule": {"promotionRange":45,"sameTierMovement":"adjacent"},
  "masteryRule": {
    "scope": "party",
    "sharedByProtagonists": 4,
    "persistsAcrossExpeditions": true,
    "sameClassContributionsMerged": true,
    "trainingTarget": "player-understanding-of-class",
    "recordDuringBattle": true,
    "checklistCompletionImmediate": true,
    "masteryCountUpdatesImmediately": true,
    "masteredEvaluatedAfterBattle": true,
    "characterDeathDoesNotRollbackProgress": true,
    "progressDisplay": {
      "checklistFormat":"current / target",
      "completedChecklistPrefix":"✓",
      "classProgressFormat":"Mastery completed / total",
      "allCompleteBeforeSettlement":"Mastery total / total · 待戰後結算",
      "afterSettlement":"MASTERED",
      "showPercentage":false,
      "visibleChecklistValueCapsAtTarget":true,
      "underlyingArchiveContinuesBeyondTarget":true
    },
    "masteredGrantsCombatStats": false,
    "masteredEffects": ["allow-transition-out", "count-for-tier3-inspiration", "persist-across-runs"],
    "tier1And2": {
      "completionModel":"class-specific-checklist",
      "checklistItemsPerClass":6,
      "commonChecklistItems":3,
      "classSpecificChecklistItems":3,
      "classSpecificBasis":["class-playstyle","passive-skill","active-skill"],
      "targetRunsToMaster":2
    },
    "tier3": {
      "usesCommonChecklist":false,
      "fixedChecklistCount":null,
      "completionModel":"fully-class-specific",
      "designGoal":"每個 Tier 3 使用完全依該職業特色設計的 Mastery，不再套用 Tier 1／2 的 3 共通 + 3 專屬模板。"
    },
    "description":"Mastery 是四名主角共用、以職業為單位的永久進度，訓練的是玩家對職業的理解。Checklist 可引用職業戰績檔案中的戰鬥、探索、事件或特定敵人相關統計作為門檻；達標與 Mastery X/Y 立即更新，只有 MASTERED 狀態在戰後正式判定。"
  },
  "classCombatArchiveRule": {
    "name":"職業戰績檔案",
    "englishName":"Class Combat Archive",
    "scope":"per-class-global",
    "persistsAcrossRuns":true,
    "sharedByProtagonists":true,
    "playerViewable":true,
    "hiddenUnrevealedClassesNotShown":true,
    "hiddenContentMustNotLeakThroughMetricNames":true,
    "continuesCountingAfterMastery":true,
    "valuesMayExceedMasteryTargets":true,
    "masteryUsesArchiveThresholds":true,
    "notLimitedToCombat":true,
    "recordCategories":["combat","exploration","map-event","event-choice","named-enemy","mini-boss","boss","class-behavior","other-class-attributable-history"],
    "examples":["battles-completed","kills","elite-boss-participation","damage-taken-events","passive-trigger-events","active-skill-kills","healing-events","map-event-entry-count","special-node-entry-count","event-choice-count","named-enemy-encounters","named-enemy-kills","mini-boss-kills","boss-kills"],
    "description":"職業戰績檔案是以職業為單位的跨 Run 長期完整歷程紀錄，不只保存戰鬥。只要某項行為可合理歸屬於玩家使用該職業時的經歷，就可持續統計；Mastery 只引用其中一部分欄位作為門檻。"
  },
  "expeditionRecordIntegrationRule": {
    "name":"本次遠征紀錄",
    "englishName":"Expedition Record",
    "scope":"current-run",
    "resetsEachRun":true,
    "notLimitedToCombat":true,
    "sameGameplayEventMayUpdateArchiveAndRunRecord":true,
    "recordCategories":["combat","exploration","map-event","event-choice","named-enemy","mini-boss","boss","relic","class-change","character-death","mastery-progress","other-run-history"],
    "usedForExpeditionReport":true,
    "usedForTitleGeneration":true,
    "titleGenerationPrefersRunDataOverLifetimeTotals":true,
    "description":"本次遠征紀錄保存當前 Run 的完整歷程，而不是只有戰鬥增量；可包含地圖事件進入、特殊節點、事件選擇、固定敵人／小 Boss／Boss 遭遇與擊敗等。Run 結束後整理成遠征報告，稱號主要從這一趟旅程的突出內容發想。"
  },
  "classDesignFramework": {
    "strategy":"framework-first",
    "defineAllClassesBeforePrototype":false,
    "statusValues":["draft","confirmed"],
    "requiredDesignFields":["basicAttack","passiveSkill","activeSkill","masteryChecklist"],
    "baseClassFieldsForMasteryPage":["sector","role","trait"],
    "prototypeRule":"所有已存在於職業樹的職業都顯示於 Mastery UI；未完成設計者明確標示為待定義。Tier 1／2 使用固定 6 項框架；Tier 3 顯示完全職業專屬 Mastery 待設計，不生成共通任務。Mastery 流程互動測試獨立放在 development/mastery-flow-demo.html，不嵌入每張職業卡。",
    "description":"先固定資料結構與 Prototype UI，再逐職業討論、測試與確認；目前 confirmed 範本為 Tier 1 戰士、斥候、法師、牧師，以及 Tier 2 騎士、狂戰士、武士、遊俠。"
  },
  "classTransitionRule": {
    "duringRunTiming":"one-fixed-midpoint-per-region","transitionPointsPerRegion":1,"transitionPointPlacement":"approximately-mid-route","randomEventRequired":false,"afterBattle":"evaluate-mastered-unlocks-and-recovery-only","currentClassMustBeMastered":true,"perCharacterTransitionCountLimit":null,"refillAllAvailableActiveSkillChargesAfterTransition":true,
    "description":"Mastery Checklist 可在遊戲進程中即時達標，但 MASTERED 與新解鎖在戰後正式判定。每個 Region 固定只有一個轉職點，原則上位於路程中段；完成轉職後，新 Build 所有可用主動技能 Charge 補滿。"
  },
  "tier3RevealRule": {"hiddenBeforeFirstUnlock":true,"hideTier3RingBeforeReveal":true,"hideTier3LabelBeforeReveal":true,"hideTier3PlaceholdersBeforeReveal":true,"hideInspirationLinksBeforeReveal":true,"firstRevealTrigger":"first-tier3-unlock","revealPresentation":"expand-or-zoom-class-tree-outward","prototypeMayShowTier3Early":true,"description":"正式遊戲在第一次 Tier 3 解鎖前完全隱藏 Tier 3 的存在。首次滿足任一 Tier 3 Inspiration 條件時，職業樹才向外展開並第一次揭露 Tier 3 外圈。Prototype 可為開發驗證提前顯示完整 Tier 3。"},
  "endgameTierExpectation": {"tier3RequiredBySystem":false,"tier3ExpectedForNormalFullClear":true,"tier2OnlyClearAllowed":true,"tier2OnlyClearIsChallengeAchievement":true,"description":"Final Region 與 Final Boss 不以系統硬性要求 Tier 3，但後期敵人強度以隊伍已取得部分 Tier 3 為正常通關基準。純 Tier 2 仍可挑戰完整 Run，若成功則屬高難度特殊成就。"},
  "inspirationRule": {
    "masteryScope":"party","requireAllLinkedTier2Masteries":true,"unlockCondition":"隊伍共用職業樹完成目標 Tier 3 所有 Inspiration Links 對應 Tier 2 職業的 Mastery 後，即解鎖該 Tier 3。","transitionRequirement":"Tier 3 解鎖後，遠征途中仍需在 Region 固定轉職點進行正式轉職，且目前職業必須已 Mastered。","relationshipRequired":false,"specialEventRequired":false,"linksAreTransitionPaths":false,
    "example":{"targets":["影刃術士","幻刃魔導士"],"tier2Links":["魔劍士","舞刃者","刺客"],"description":"共用職業樹完成魔劍士、舞刃者與刺客三個職業 Mastery 後，同時符合影刃術士與幻刃魔導士的 Inspiration 條件。"}
  },
  "legacyTraitRule":{"enabled":false,"status":"archived","description":"舊版 Mastery 後留下弱化被動 Legacy Trait 的規則已取消，由完整技能繼承取代。"},
  "specialClassRule":{"outsideConcentricClassTree":true,"displayedAsExternalNodes":true,"finalClassCount":4,"onePerSector":true,"sectors":["warrior","agile","magic","support"],"isTier4":false,"isFinalClass":true,"unlockRequiresAllSectorTier3Masteries":true,"unlockRequiresCorrespondingSpecialRelic":true,"unlockLogic":"AND","duplicateSameSpecialClassInPartyAllowed":false,"differentSpecialClassesMayCoexist":true,"normalMasteryTemplateApplies":false,"skillInheritance":"to-be-defined","description":"四個最終特殊職業各代表一個主要職業系，獨立顯示在原 Tier 0～3 同心圓之外，不是 Tier 4。解鎖必須同時完成該職業系要求的全部 Tier 3 Mastery，並取得該系對應特殊遺產。同一隊伍不可重複使用同一特殊職業；不同特殊職業可並存。"},
  "classDesigns": {
    "tier1_warrior":{"status":"confirmed","basicAttack":{"name":"近戰攻擊","range":1,"damageType":"physical","attackStyle":"melee","charges":null,"effect":"對相鄰敵人進行不消耗 Charge 的物理普通攻擊。"},"passiveSkill":{"name":"堅守","effect":"受到敵方攻擊後，直到下一次自身行動開始前，後續受到的傷害降低 29%。","damageReductionPercent":29,"firstHitReduced":false,"stackable":false},"activeSkill":{"name":"猛擊","maxCharges":9,"chargeCost":1,"skillType":"general-attack","range":1,"damageType":"physical","effect":"對相鄰敵人造成約普通攻擊 1.5 倍的近戰傷害。","damageMultiplierPrototype":1.5},"masteryChecklist":[{"id":"warrior_common_battles","archiveMetric":"battles-completed","category":"common","description":"使用戰士完成戰鬥","target":24,"unit":"場"},{"id":"warrior_common_kills","archiveMetric":"kills","category":"common","description":"使用戰士擊倒敵人","target":45,"unit":"名"},{"id":"warrior_common_elite_boss","archiveMetric":"elite-boss-participation","category":"common","description":"使用戰士參與擊敗 Elite / Boss","target":8,"unit":"次"},{"id":"warrior_playstyle_take_hits","archiveMetric":"damage-taken-events","category":"class-playstyle","description":"使用戰士承受敵方攻擊","target":60,"unit":"次"},{"id":"warrior_passive_hold_fast_hits","archiveMetric":"hold-fast-damage-taken-events","category":"passive-skill","description":"在「堅守」生效期間受到敵方攻擊","target":30,"unit":"次"},{"id":"warrior_active_slam_kills","archiveMetric":"slam-kills","category":"active-skill","description":"使用「猛擊」擊倒敵人","target":20,"unit":"次"}]},
    "tier1_scout":{"status":"confirmed","basicAttack":{"name":"近戰攻擊","range":1,"damageType":"physical","attackStyle":"melee","charges":null,"effect":"對相鄰敵人進行不消耗 Charge 的物理普通攻擊。"},"passiveSkill":{"name":"游擊","effect":"本回合若先移動，再進行普通攻擊或主動技能，行動結束後獲得暫時閃避提升，持續至下一次自身行動開始。","evasionBonusPrototype":"15%-20%","stackable":false},"activeSkill":{"name":"疾行","maxCharges":6,"chargeCost":1,"skillType":"general-support","effect":"本回合移動距離 +3 格。技能本身不直接造成傷害，使用後仍可依一般行動規則執行合法行動。"},"masteryChecklist":[{"id":"scout_common_battles","archiveMetric":"battles-completed","category":"common","description":"使用斥候完成戰鬥","target":24,"unit":"場"},{"id":"scout_common_kills","archiveMetric":"kills","category":"common","description":"使用斥候擊倒敵人","target":45,"unit":"名"},{"id":"scout_common_elite_boss","archiveMetric":"elite-boss-participation","category":"common","description":"使用斥候參與擊敗 Elite / Boss","target":8,"unit":"次"},{"id":"scout_playstyle_move_then_action","archiveMetric":"move-then-action-events","category":"class-playstyle","description":"先移動，再於同一回合完成普通攻擊或主動技能","target":50,"unit":"次"},{"id":"scout_passive_guerrilla_evade","archiveMetric":"guerrilla-evasion-events","category":"passive-skill","description":"觸發「游擊」後，在效果持續期間成功迴避敵方攻擊","target":15,"unit":"次"},{"id":"scout_active_dash_action","archiveMetric":"dash-then-normal-attack-events","category":"active-skill","description":"使用「疾行」後，在同一回合完成普通攻擊","target":20,"unit":"次"}]},
    "tier1_mage":{"status":"confirmed","basicAttack":{"name":"魔法射擊","range":2,"damageType":"magic","attackStyle":"ranged","charges":null,"effect":"對 2 格內單一敵人進行不消耗 Charge 的遠距魔法普通攻擊。"},"passiveSkill":{"name":"凝神","effect":"本回合施放造成傷害的主動技能前若未移動，該次主動技能造成的傷害提高 30%。","damageBonusPercent":30,"requiresNoMovementBeforeCast":true},"activeSkill":{"name":"魔力彈","maxCharges":9,"chargeCost":1,"skillType":"general-attack","range":3,"damageType":"magic","effect":"對 3 格內單一敵人造成約普通攻擊 1.5 倍的魔法傷害。","damageMultiplierPrototype":1.5},"masteryChecklist":[{"id":"mage_common_battles","archiveMetric":"battles-completed","category":"common","description":"使用法師完成戰鬥","target":24,"unit":"場"},{"id":"mage_common_kills","archiveMetric":"kills","category":"common","description":"使用法師擊倒敵人","target":45,"unit":"名"},{"id":"mage_common_elite_boss","archiveMetric":"elite-boss-participation","category":"common","description":"使用法師參與擊敗 Elite / Boss","target":8,"unit":"次"},{"id":"mage_playstyle_ranged_damage","archiveMetric":"damage-from-two-plus-tiles","category":"class-playstyle","description":"在距離敵人 2 格以上的位置造成傷害","target":50,"unit":"次"},{"id":"mage_passive_focus_hits","archiveMetric":"focus-boosted-active-hits","category":"passive-skill","description":"觸發「凝神」後，以獲得加成的主動技能命中敵人","target":30,"unit":"次"},{"id":"mage_active_magic_bolt_kills","archiveMetric":"magic-bolt-kills","category":"active-skill","description":"使用「魔力彈」擊倒敵人","target":20,"unit":"次"}]},
